msgid ""
"BFpack does not accept factor levels that contain spaces. Please remove the"
"spaces from your factor levels to continue."
msgstr ""
"BFpack accepteert geen factorlevels die spaties bevatten. Verwijder de spaties "
"uit uw factorlevels om verder te gaan."

msgid "Only two variables can be specified for the paired samples t-test."
msgstr "Voor de t-toets voor gepaarde steekproeven kunnen slechts twee variabelen worden opgegeven."

#, qt-format
msgid "The parameter estimation failed. Error message: %1$s"
msgstr "De parameterschatting is mislukt. Foutmelding: %1$s"

#, qt-format
msgid "Could not extract parameter names. Error message: %1$s"
msgstr "Kon de parameternamen niet extraheren. Foutmelding: %1$s"

msgid ""
"BFpack does not accept factor levels that start with a number. Please remove"
"the numbers from your factor levels to continue."
msgstr ""
"BFpack accepteert geen factorlevels die beginnen met een getal. Verwijder de "
"getallen uit uw factorlevels om verder te gaan."

msgid ""
"BFpack failed because of an issue with the specification of the manual"
"hypotheses. Please check that you specified them correctly. You should then"
"refresh the analysis."
msgstr ""
"BFpack is mislukt vanwege een probleem met de specificatie van de handmatige "
"hypothesen. Controleer of u deze correct hebt opgegeven. Vernieuw vervolgens "
"de analyse."

#, qt-format
msgid "BFpack failed with the following error message: %1$s"
msgstr "BFpack is mislukt met de volgende foutmelding: %1$s"

msgid "Posterior Probabilities of the Standard Hypotheses"
msgstr "Posterieure kansen van de standaardhypothesen"

