msgstr "Referentiewaarde gebruikt in de standaard hypothesetoets voor %1."

msgctxt "HypothesesWindowStandard|"
msgid "Prior weight for the second standard hypothesis."
msgstr "A-priori-gewicht voor de tweede standaardhypothese."

msgctxt "HypothesesWindowStandard|"
