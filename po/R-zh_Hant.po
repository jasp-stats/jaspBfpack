msgstr "P(>0)"

msgid "The uncertainty interval is a central credible interval."
msgstr "不確定區間為中心可信區間。"

msgid "The uncertainty interval is a frequentist confidence interval."
msgstr "不確定區間為頻率學派置信區間。"

msgid ""
"The uncertainty interval is a frequentist confidence interval as well as a"
"credible interval with a noninformative Jeffrey's prior."
msgstr ""
"不確定區間既是頻率學派置信區間，也是採用無資訊Jeffrey先驗的可信區間。"

msgid "Log Standard Hypotheses: View BFs"
msgstr "對數標準假設：檢視BFs"

msgid "Standard Hypotheses: View BFs"
msgstr "標準假設：檢視BFs"

msgid "H0 vs. H±)"
msgstr "H0對H±)"

msgid "H± vs. H0"
msgstr "H±對H0"

